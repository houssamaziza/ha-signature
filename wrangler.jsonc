{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ha-signature",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Base de données (Prisma + @prisma/adapter-d1)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ha-signature",
      "database_id": "3b0f10cc-6b1f-4db9-98a3-e175224a054d",
      "migrations_dir": "migrations"
    }
  ],

  // Photos et plans envoyés depuis l'administration
  "kv_namespaces": [
    { "binding": "MEDIA", "id": "74b39905aa574d53ba82dd0c828e3f48" }
  ],

  // Variables publiques (les secrets se règlent avec `wrangler secret put`)
  "vars": {
    "SITE_URL": "https://ha-signature.houssam-aziza-037.workers.dev",
    "DEFAULT_PROJECT_SLUG": "la-caroube-2",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "H&A Signature <noreply@hasignature.com>",
    "LEAD_NOTIFICATION_EMAILS": "info@hasignature.com",
    "LEAD_ACKNOWLEDGEMENT": "false",
    // Verrou temporaire : sha256 du mot de passe d'accès au site. Supprimer cette ligne pour ouvrir le site au public.
    "SITE_LOCK_HASH": "3ffa855266888df162412e04e8691eab3b66155b30bcb33b1e2591694edf2772"
  }
}
